# Copy to .env and adjust. Read by docker-compose.yml and by the backend (app/config.py).

# PostgreSQL (docker compose uses these to create the database)
POSTGRES_USER=anichara
POSTGRES_PASSWORD=anichara
POSTGRES_DB=anichara
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: full SQLAlchemy URLs. When set they override the POSTGRES_* values above.
# DATABASE_URL=postgresql+psycopg://anichara:anichara@localhost:5432/anichara
# The test suite drops and recreates this database. Defaults to <POSTGRES_DB>_test.
# TEST_DATABASE_URL=postgresql+psycopg://anichara:anichara@localhost:5432/anichara_test

# Comma separated origins allowed to call the API directly (the Vite dev server proxies /api anyway).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
